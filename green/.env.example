# GreenForge settings. Copy to .env or set in your host's env UI. Never commit a real key.
# Optional: Opencode Go API key — used for LLM ranking when set (numbers still come from the verifier).
OPENCODE_API_KEY=
# Opencode Go model id (Go endpoint: https://opencode.ai/zen/go/v1)
OPENCODE_GO_MODEL=mimo-v2.6-flash
# Optional alternative: OpenAI (used only when OPENCODE_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Port the app listens on
PORT=8000
# Optional: path to an EnergyPlus IDF template to enable full EnergyPlus runs where the binary is installed
ENERGYPLUS_IDF_TEMPLATE=
