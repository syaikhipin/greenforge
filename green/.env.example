# GreenForge settings. Copy to .env or set in your host's env UI. Never commit a real key.
# Optional: OpenAI API key — enables LLM ranking of candidate fixes (numbers still come from the verifier).
OPENAI_API_KEY=
# OpenAI model id
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible base URL (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Port the app listens on
PORT=8000
# Optional: path to an EnergyPlus IDF template to enable full EnergyPlus runs where the binary is installed
ENERGYPLUS_IDF_TEMPLATE=
